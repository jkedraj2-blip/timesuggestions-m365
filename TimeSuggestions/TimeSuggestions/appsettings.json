{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=timesuggestions.db"
  },
  "Suggestions": {
    "MinimumEventDurationMinutes": 5,
    "DefaultDocumentDurationMinutes": 30,
    "SyncDaysBack": 7,
    "BusinessTimeZoneId": "Europe/Warsaw",
    "SessionContinuationGapMinutes": 15,
    "SessionFlaggedGapMinutes": 30,
    "SessionLeadInMinutes": 10,
    "MinimumSessionMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
